# ============================================================
# DocAssistIQ Environment Configuration
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit real secrets to version control.
#
# For local Docker Compose development, use Docker service
# hostnames (db, redis, minio) NOT localhost.
# For running backend/frontend natively, use localhost.
# ============================================================

# --- Application ---
APP_NAME=DocAssistIQ
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_SECRET_KEY=
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000

# --- Database (Docker: use 'db'; native: use 'localhost') ---
POSTGRES_DB=docassistiq
POSTGRES_USER=docassistiq
POSTGRES_PASSWORD=changeme
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://docassistiq:changeme@db:5432/docassistiq
DATABASE_ECHO=false

# --- Redis (Docker: use 'redis'; native: use 'localhost') ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Object Storage / MinIO ---
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=docassistiq
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# --- JWT / Auth (future phases) ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
